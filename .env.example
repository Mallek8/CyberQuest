# Docker Compose reads this file from the repository root.
# The database password below must match POSTGRES_PASSWORD.

POSTGRES_USER=cyberquest
# Avoid @ : / in the password. Compose inserts it into DATABASE_URL.
POSTGRES_PASSWORD=cyberquest
POSTGRES_DB=cyberquest

JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# deterministic uses curated hints. llm paraphrases them when LLM_API_KEY is set.
AI_PROVIDER=deterministic
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
HINT_LIMIT_PER_MISSION=3
BCRYPT_ROUNDS=12

API_PROXY_TARGET=http://backend:8000
